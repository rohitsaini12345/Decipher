<!DOCTYPE html>
<html>
<head>
    <title>Profile</title>
</head>
<body>
    <h2>User Profile</h2>
	
    <p><strong>Name:</strong> <span th:text="${user.Name}"></span></p>
   
    <pstrong>Email:</strong> <span th:text="${user.email}"></span></p>

    <a th:href="@{'/user/edit/' + ${user.id}}">Edit Profile</a><br/> |
	
	<form th:action="@{'/user/delete/' + ${user.id}}" method="post">
	    <button type="submit">Delete Account</button>
	</form>
	
    <a th:href="@{/logout}">Logout</a>
</body>
</html>
