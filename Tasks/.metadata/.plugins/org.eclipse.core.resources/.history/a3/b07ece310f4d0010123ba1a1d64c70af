<!DOCTYPE html>
<html >
<head>
    <title>User Registration</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 10px;
        }

        form {
            width: 300px;
            margin: 0 auto;
        }

        label {
            display: inline-block;
            width: 100px;
            margin-bottom: 10px;
        }

        input {
            width: 100%;
            padding: 5px;
            margin-bottom: 15px;
        }

        button {
            width: 100%;
            padding: 8px;
            background-color: #4CAF50;
            color: white;
            border: none;
            cursor: pointer;
        }

        button:hover {
            background-color: #45a049;
        }

        .link {
            text-align: center;
            margin-top: 15px;
        }
    </style>
</head>
<body>
    <h2 style="text-align: left;">Register</h2>

    <form style="text-align: left;" th:action="@{/register}" method="post" th:object="${user}">
        <label>Name:</label>
        <input type="text" th:field="*{name}" required /><br/>

        <label>Email:</label>
        <input type="email" th:field="*{email}" required /><br/>

        <label>Password:</label>
        <input type="password" th:field="*{password}" required /><br/>

        <button type="submit">Register</button>
    </form>

    <div class="link">
        <p>Already have an account? <a th:href="@{/login}">Login here</a></p>
    </div>
</body>
</html>
